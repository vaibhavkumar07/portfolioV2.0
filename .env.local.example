# Copy to .env.local and fill in. Never commit real keys.

# LLM agent brain — NVIDIA NIM (https://build.nvidia.com)
NVIDIA_CHAT_API_KEY=

# Optional: Edge neural TTS voice (default en-US-GuyNeural)
TTS_VOICE=en-US-GuyNeural

# Optional: durable rate limiting (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
